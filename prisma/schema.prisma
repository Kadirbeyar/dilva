// ═══════════════════════════════════════════════════════════════════════
// Dilva — Prisma Schema
// Language-exchange & social platform (HelloTalk-style)
// DB: Supabase Postgres. Auth is handled by Supabase Auth (auth.users);
// `User.id` below stores that same UUID (see prisma/sql/00_auth_trigger.sql
// for the trigger that keeps them in sync on signup).
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum LanguageType {
  NATIVE
  LEARNING
}

enum ProficiencyLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  ADVANCED
  FLUENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  CORRECTION
  SYSTEM
}

enum SubscriptionPlan {
  MONTH_1
  MONTH_3
  MONTH_6
  MONTH_12
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// How a user says they paid outside Stripe — see ManualPaymentRequest.
/// Iraq (and much of the world) isn't reachable by Stripe/PayPal/etc.,
/// so this lets Premium be sold TODAY via a manual "I sent the money,
/// here's proof" -> admin-reviews-and-approves flow, in parallel with
/// getting a real local payment gateway (PayTabs/Qi Card) approved.
enum ManualPaymentMethod {
  BANK_TRANSFER
  CRYPTO
  /// FIB (First Iraqi Bank) app transfer — a very common way to send
  /// money instantly inside Iraq, alongside the Qi Card details
  /// already covered by BANK_TRANSFER. Kept as its own method (rather
  /// than folded into BANK_TRANSFER's free-text info) so it shows as
  /// its own selectable card on /premium.
  FIB
}

enum ManualPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  NEW_MESSAGE
  NEW_LIKE
  NEW_COMMENT
  NEW_CORRECTION
  NEW_FOLLOWER
  PROFILE_VISIT
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_EXPIRING
  SYSTEM
  /// A manual (bank transfer / crypto) Premium payment was rejected by
  /// an admin — approval reuses SUBSCRIPTION_ACTIVATED above instead,
  /// since that's already exactly the right message either way.
  MANUAL_PAYMENT_REJECTED
  /// Sent to BOTH sides of a referral (the referrer and the new
  /// signup) once the referred person finishes onboarding — see
  /// lib/referral.ts.
  REFERRAL_BONUS_EARNED
  /// Sent to everyone who follows a user, the moment that user starts
  /// a Voice Room — invites them in. data carries { fromUserId, roomId,
  /// topic }. See api/voice-rooms POST.
  VOICE_ROOM_STARTED
}

// ─────────────────────────────────────────────────────────────
// Core identity
// ─────────────────────────────────────────────────────────────

/// Public profile row, 1:1 with Supabase auth.users (id is shared).
/// Everything the USER chooses themselves (username, bio, languages...)
/// lives here — never auto-generated by the system.
model User {
  id       String @id @db.Uuid
  username String @unique @db.VarChar(30)

  /// Mirrors auth.users.email (Supabase Auth owns the real value; this
  /// is a denormalized copy kept in sync by the signup trigger — see
  /// prisma/sql/00_auth_trigger.sql / 17_username_login.sql) purely so
  /// the app can look up "which email does this username belong to"
  /// for username-based login (see /api/auth/login) without a second
  /// database/schema round trip. Never selected into any
  /// publicly-facing API response — treat like latitude/longitude
  /// (private, app-internal use only), not a public profile field.
  email String? @unique @db.VarChar(255)

  displayName String? @db.VarChar(60)
  bio         String? @db.Text
  avatarUrl   String?

  gender    Gender?
  birthDate DateTime? @db.Date

  country String?
  city    String?

  // Precise coordinates — only ever populated/used for the Premium
  // "Nearby" feature, and only when the user opts in.
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?
  isLocationVisible Boolean   @default(false)

  isOnline   Boolean   @default(false)
  lastSeenAt DateTime?

  // Denormalized flag kept in sync by the Stripe webhook so hot-path
  // reads (feed, chat) don't need to join Subscription every time.
  isPremiumCached Boolean @default(false)

  /// Grants access to the /admin stats dashboard. Set by hand via SQL
  /// (see prisma/sql/02_follows_and_admin.sql) — there is no self-serve
  /// signup path to becoming an admin.
  isAdmin Boolean @default(false)

  /// Free Premium access granted outside of Stripe/manual payments
  /// (currently: the referral program — see lib/referral.ts). Kept as
  /// its own column rather than a fake Subscription row so referral
  /// bonuses never show up as revenue in the admin dashboard or
  /// Payment history. isPremiumUser() in lib/premium.ts treats "in the
  /// future" here as equivalent to an active paid subscription.
  premiumBonusUntil DateTime?

  /// Set once, at onboarding, if the signup arrived via someone else's
  /// referral link (?ref=<username>) — never changed afterward, even
  /// if that person later renames their account. Self-relation to the
  /// referrer; see the `referrals` field below for the reverse list.
  referredById String? @db.Uuid
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Referrals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  languages UserLanguage[]

  posts       Post[]
  comments    Comment[]
  corrections Correction[] @relation("CorrectionAuthor")
  likes       Like[]

  sentMessages  Message[]                  @relation("MessageSender")
  conversations ConversationParticipant[]

  /// Small live-audio group rooms this user has created/hosted — see
  /// VoiceRoom below. Actual in-room participants are NOT modeled
  /// here (tracked ephemerally via Supabase Realtime Presence, not
  /// the database), only who owns/can end a room.
  hostedVoiceRooms VoiceRoom[]

  subscription Subscription?
  payments     Payment[]

  manualPaymentRequests ManualPaymentRequest[]

  visitsMade     ProfileVisit[] @relation("Visitor")
  visitsReceived ProfileVisit[] @relation("Visited")

  blocksMade      Block[] @relation("Blocker")
  blocksReceived  Block[] @relation("Blocked")

  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("ReportedUser")

  notifications Notification[]

  pushSubscriptions PushSubscription[]

  /// Rows where THIS user is the one doing the following (i.e. people
  /// I follow). See Follow model below.
  following Follow[] @relation("FollowFollower")
  /// Rows where THIS user is being followed (i.e. my followers).
  followedBy Follow[] @relation("FollowFollowing")

  @@index([country])
  @@index([latitude, longitude])
  @@map("users")
}

/// Reference table of supported spoken/learning languages.
/// Seeded in prisma/seed.ts — includes Kurdish (Badini, Arabic script),
/// Turkish, English and the common HelloTalk-style catalogue.
model Language {
  code       String  @id // e.g. "kmr-badini", "tr", "en", "ar", "es"...
  name       String // English display name, e.g. "Kurdish (Badini)"
  nativeName String // name written in its own script, e.g. "کوردی (بادینی)"
  isRtl      Boolean @default(false)

  userLanguages UserLanguage[]
  posts         Post[]

  @@map("languages")
}

/// Join table: which languages a user speaks natively vs. is learning.
/// A user may have several NATIVE and several LEARNING rows — the
/// matching engine (lib/matching.ts) queries this table directly.
model UserLanguage {
  id String @id @default(cuid())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  languageCode String
  language     Language @relation(fields: [languageCode], references: [code])

  type         LanguageType
  proficiency  ProficiencyLevel? // meaningful for LEARNING rows
  isPrimary    Boolean           @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, languageCode, type])
  @@index([languageCode, type])
  @@map("user_languages")
}

// ─────────────────────────────────────────────────────────────
// Social feed ("Moments") — posts, comments, likes, corrections
// ─────────────────────────────────────────────────────────────

model Post {
  id String @id @default(cuid())

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  languageCode String?
  language     Language? @relation(fields: [languageCode], references: [code])

  imageUrl String?
  videoUrl String?

  /// Author is explicitly inviting natives to correct this text.
  correctionRequested Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    Comment[]
  corrections Correction[]
  likes       Like[]
  reports     Report[]

  @@index([authorId])
  @@index([languageCode])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("comments")
}

/// A native-speaker correction attached to a post — the core
/// HelloTalk-style "learn from each other" mechanic.
model Correction {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation("CorrectionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  originalText  String @db.Text
  correctedText String @db.Text
  note          String? @db.Text

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("corrections")
}

model Like {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("likes")
}

/// Directed follow relationship — a row means `follower` follows
/// `following`. Two people mutually following each other is simply
/// two rows, one in each direction (see /api/users/[username]/follow).
model Follow {
  id String @id @default(cuid())

  followerId String @db.Uuid
  follower   User   @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String @db.Uuid
  following   User   @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
  @@map("follows")
}

// ─────────────────────────────────────────────────────────────
// Realtime chat
// ─────────────────────────────────────────────────────────────

model Conversation {
  id      String  @id @default(cuid())
  isGroup Boolean @default(false)
  title   String? // only used for group conversations

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  /// Silences bell/push notifications for future messages in this
  /// thread, for THIS participant only — see
  /// prisma/sql/20_chat_mute_and_media.sql and
  /// /api/conversations/[id]/mute. Does not hide the conversation or
  /// block the other person.
  isMuted Boolean @default(false)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

/// A small, public, topic-based live-audio room — think "a table of
/// 2-6 people talking out loud", not a Clubhouse-scale stage with
/// hundreds of listeners. Kept intentionally lightweight: audio
/// itself is peer-to-peer WebRTC between participants' browsers
/// (mesh — practical at this small size, no media-server/SFU needed)
/// with signaling over a Supabase Realtime broadcast channel named
/// `voice-room:<id>`; only room metadata (topic, host, is it still
/// open) lives in Postgres. See src/components/voiceRooms/VoiceRoomView.tsx.
model VoiceRoom {
  id String @id @default(cuid())

  topic String @db.VarChar(120)

  hostId String @db.Uuid
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  /// Hard cap enforced client-side when joining (checked against the
  /// live Presence member count, not a DB count).
  maxParticipants Int @default(6)

  isActive Boolean   @default(true)
  createdAt DateTime @default(now())
  endedAt   DateTime?

  @@index([isActive, createdAt])
  @@map("voice_rooms")
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String @db.Uuid
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  type    MessageType @default(TEXT)
  content String      @db.Text

  originalLanguageCode String?
  mediaUrl             String?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  /// Cached per-target-language translations so we don't re-call
  /// LibreTranslate every time the same message is re-rendered.
  translations MessageTranslation[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageTranslation {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  targetLanguageCode String
  translatedText      String @db.Text

  createdAt DateTime @default(now())

  @@unique([messageId, targetLanguageCode])
  @@map("message_translations")
}

// ─────────────────────────────────────────────────────────────
// Premium: Profile Visitors & Nearby
// ─────────────────────────────────────────────────────────────

/// Recorded every time a user opens another user's profile.
/// Free users can see only the COUNT; Premium users can see WHO
/// (see lib/premium.ts + /api/visitors).
model ProfileVisit {
  id String @id @default(cuid())

  visitorId String @db.Uuid
  visitor   User   @relation("Visitor", fields: [visitorId], references: [id], onDelete: Cascade)

  visitedId String @db.Uuid
  visited   User   @relation("Visited", fields: [visitedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([visitedId, createdAt])
  @@index([visitorId])
  @@map("profile_visits")
}

// ─────────────────────────────────────────────────────────────
// Freemium / Subscriptions (Stripe)
// ─────────────────────────────────────────────────────────────

model Subscription {
  id String @id @default(cuid())

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus @default(INCOMPLETE)

  /// Snapshot of the USD price charged when this subscription was
  /// created — see lib/plans.ts for the canonical price list
  /// (1mo $10 · 3mo $25 · 6mo $42 · 12mo $80).
  priceUsd Decimal @db.Decimal(10, 2)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id String @id @default(cuid())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  amountUsd Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)

  stripePaymentIntentId  String? @unique
  stripeCheckoutSessionId String? @unique

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("payments")
}

/// A user's own claim of having paid outside Stripe (bank/Qi Card
/// transfer, or crypto) — the fast-to-launch stopgap while a real
/// local payment gateway is still being set up (see lib/plans.ts for
/// the plan catalogue this reuses). An admin reviews `note` (whatever
/// the user typed to help match it to a real transfer — sender name,
/// last digits, a crypto tx hash) against what actually arrived, then
/// approves or rejects from /admin. Approving does exactly what the
/// Stripe webhook does on a real payment: upserts Subscription,
/// creates a Payment record, and flips User.isPremiumCached.
model ManualPaymentRequest {
  id String @id @default(cuid())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  method ManualPaymentMethod

  note String @db.Text

  status ManualPaymentStatus @default(PENDING)

  reviewedAt   DateTime?
  /// Admin who approved/rejected this. Deliberately not a Prisma
  /// relation (no back-reference needed on User) — just the raw id.
  reviewedById String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([status])
  @@index([userId])
  @@map("manual_payment_requests")
}

// ─────────────────────────────────────────────────────────────
// Safety & notifications
// ─────────────────────────────────────────────────────────────

model Block {
  id String @id @default(cuid())

  blockerId String @db.Uuid
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String @db.Uuid
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id String @id @default(cuid())

  reporterId String @db.Uuid
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUserId String @db.Uuid
  reportedUser   User   @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  /// Set when this report is about a specific Post (e.g. sexual/porn
  /// content) rather than the account in general. Nullable so
  /// account-level reports keep working. Deleting the post also
  /// deletes reports about it (nothing left to review).
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  reason  String
  details String? @db.Text
  status  ReportStatus @default(OPEN)

  createdAt DateTime @default(now())

  @@index([reportedUserId])
  @@index([postId])
  @@map("reports")
}

model Notification {
  id String @id @default(cuid())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   NotificationType
  data   Json?
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

/// Single-row table (id is always "singleton") of small app-wide
/// settings an admin can change without a redeploy — currently just
/// the floating radio player's stream URL (see /api/settings/radio,
/// components/layout/RadioPlayerButton.tsx). Add more columns here
/// later rather than a new table per setting.
model AppSetting {
  id             String  @id @default("singleton")
  radioStreamUrl String?
  radioLabel     String?

  /// Free-text instructions shown on /premium for paying manually —
  /// bank/Qi Card details and a crypto (USDT) address/network. Kept
  /// here (admin-editable, no redeploy) rather than hardcoded, since
  /// account details can change and shouldn't require a code change.
  manualPaymentBankInfo   String? @db.Text
  manualPaymentCryptoInfo String? @db.Text
  /// FIB (First Iraqi Bank) app transfer details — phone number/name
  /// to send to. Separate from manualPaymentBankInfo so it renders as
  /// its own method card on /premium.
  manualPaymentFibInfo    String? @db.Text

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// Backing store for lib/rateLimit.ts's fixed-window limiter (posts,
/// messages, and similar write-heavy endpoints). One row per (key,
/// windowStart) — key encodes both the action and who's doing it, e.g.
/// "post_create:<userId>". Old rows are opportunistically deleted by
/// the same helper rather than needing a cron job. No Prisma relations
/// on purpose: this table is written via raw SQL (a single upsert per
/// request) rather than the Prisma client API, to keep each check to
/// one round trip against the connection_limit=1 pooler.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@map("rate_limits")
}

/// One row per browser/device that has granted Web Push permission —
/// a user can have several (phone + laptop, etc.). `endpoint` is the
/// push service URL the browser gave us (unique per
/// browser+device+site) and `p256dh`/`auth` are the encryption keys
/// web-push needs to encrypt the payload — see lib/webpush.ts, which
/// deletes a row here automatically once its push service reports the
/// subscription as gone (410/404), e.g. after the user uninstalls the
/// app or clears site data.
model PushSubscription {
  id String @id @default(cuid())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique @db.Text
  p256dh   String @db.Text
  auth     String @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}
